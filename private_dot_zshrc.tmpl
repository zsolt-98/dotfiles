# Managed by chezmoi. Machine-only tweaks go in ~/.zshrc.local (untracked).

# Shared env for zsh + bash: brew, PATH, pnpm, editor, FZF, Claude Code
source "$HOME/.config/shell/env.sh"

# --- Remove duplicate PATH entries (zsh feature) ---
typeset -U path PATH

# --- mise (node LTS, pnpm, python) ---
command -v mise >/dev/null && eval "$(mise activate zsh)"

# Path to Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"

# Theme
ZSH_THEME="robbyrussell"

# chezmoi externals pull oh-my-zsh weekly, so its own updater is off
zstyle ':omz:update' mode disabled

# --- zsh-vi-mode settings (must be set before the plugin loads) ---
ZVM_TERM=xterm-256color
ZVM_VI_HIGHLIGHT_BACKGROUND={{ .palette.selection }}
ZVM_VI_HIGHLIGHT_FOREGROUND={{ .palette.foreground }}

# Plugins
plugins=(git zsh-vi-mode zsh-autosuggestions)

# Load Oh My Zsh
source $ZSH/oh-my-zsh.sh

# --- Cursor shape + color per vi mode (matches macOS config) ---
function preexec() {
  case "$1" in
    nvim*) print -n '\e]12;{{ .palette.cyan }}\a' ;;   # set cyan before nvim launches
  esac
}

function precmd() {
  print -n '\e[5 q\e]12;{{ .palette.green }}\a'         # restore green beam (INSERT) after command exits
}

# zsh-vi-mode resets keybindings on init, so (re)load fzf bindings here
function zvm_after_init() {
  command -v fzf >/dev/null && source <(fzf --zsh)
  print -n '\e[5 q\e]12;{{ .palette.green }}\a'         # initial cursor: beam + green (INSERT)
}

function zvm_after_select_vi_mode() {
  case $ZVM_MODE in
    $ZVM_MODE_NORMAL) print -n '\e[2 q\e]12;{{ .palette.cyan }}\a' ;;  # block + cyan (NORMAL)
    $ZVM_MODE_INSERT) print -n '\e[5 q\e]12;{{ .palette.green }}\a' ;;  # beam + green (INSERT)
    $ZVM_MODE_VISUAL) print -n '\e[2 q\e]12;{{ .palette.yellow }}\a' ;;  # block + yellow (VISUAL)
  esac
}

# --- herdr resurrect: relaunch nvim/lazygit after a herdr or machine restart ---
# Inside a herdr pane, record the running command in a state file named after the pane.
# A normal exit deletes the file. A kill (SIGHUP/SIGTERM/SIGKILL from a server stop or
# shutdown) leaves it, and the plugin in ~/.config/herdr/plugins/resurrect replays it.
if [[ -n $HERDR_PANE_ID ]]; then
  function _herdr_resurrect() {
    local dir="${XDG_STATE_HOME:-$HOME/.local/state}/herdr-resurrect"
    local file="$dir/${HERDR_PANE_ID//[^A-Za-z0-9_-]/_}"
    mkdir -p "$dir"
    print -r -- "$HERDR_PANE_ID"$'\n'"$PWD"$'\n'"${(j: :)${(q)@}}" >| "$file"
    command "$@"
    local rc=$?
    case $rc in
      129|137|143) ;;     # killed by HUP/KILL/TERM: keep the file for the next start
      *) rm -f "$file" ;;
    esac
    return $rc
  }
  function nvim() { _herdr_resurrect nvim "$@" }
  function lazygit() { _herdr_resurrect lazygit "$@" }
fi

# --- Machine-local overrides (untracked) ---
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
