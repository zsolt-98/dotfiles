#!/bin/sh
# Claude Code from the official installer (installs to ~/.local/bin/claude and self-updates).
# Then the caveman plugin, which dot_claude/settings.json enables (skills plus always-on hooks).
{{ template "lib.sh" . }}

if have claude; then
  log "Claude Code already installed"
else
  log "Installing Claude Code"
  curl -fsSL https://claude.ai/install.sh | bash
fi

# Both commands fail harmlessly when already added/installed; never fail the apply.
if have claude; then
  log "Installing caveman plugin"
  claude plugin marketplace add JuliusBrussee/caveman || true
  claude plugin install caveman@caveman || true
else
  warn "claude not found: skipping caveman plugin"
fi
