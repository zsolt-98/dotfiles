# Shared CLI tools for Linux (Linuxbrew) and macOS.
# Installed by .chezmoiscripts/run_onchange_before_20-packages.sh.tmpl, which re-runs when this file changes.
# zsh is not here: it comes from the system package manager, so chsh accepts it (/etc/shells).

brew "git"
brew "neovim"
brew "tmux"
brew "fzf"
brew "fd"
brew "ripgrep"
brew "lazygit"
brew "gh"
brew "herdr"
brew "w3m"
brew "mise"
brew "chezmoi"

if OS.mac?
  # Fedora gets podman from dnf (packages/dnf.txt).
  brew "podman"
  # Builds Alacritty from source (.chezmoiscripts/run_onchange_before_25-alacritty): its cask is
  # disabled because the app is not notarized, and a locally built app skips Gatekeeper.
  brew "rust"

  cask "font-jetbrains-mono-nerd-font"
end
