# Shared CLI tools for Linux (Linuxbrew) and macOS.
# Installed by .chezmoiscripts/run_onchange_before_20-packages.sh.tmpl, which re-runs when this file changes.
# zsh is not here: it comes from the system package manager, so chsh accepts it (/etc/shells).
# DOTFILES_PROFILE (desktop | headless) is set by the install script.

brew "git"
brew "neovim"
brew "tmux"
brew "fzf"
brew "fd"
brew "ripgrep"
brew "lazygit"
brew "gh"
brew "herdr"
brew "w3m"
brew "mise"
brew "chezmoi"

if OS.mac?
  # Linux gets podman from dnf/apt (packages/*.txt).
  brew "podman"

  if ENV["DOTFILES_PROFILE"] == "desktop"
    cask "alacritty"
    cask "font-jetbrains-mono-nerd-font"
  end
end
