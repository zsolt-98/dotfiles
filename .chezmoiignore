# Repo-only files: never copied into $HOME.
README.md
install.sh
packages/

# Managed by Claude itself (claude.ai synced skills).
.claude/skills/synced

# Sway stack: Linux (Fedora Sway) only.
{{ if ne .chezmoi.os "linux" }}
.config/sway
.config/rofi
{{ end }}

# Terminal: Alacritty on Linux, Ghostty on macOS (Homebrew disabled the Alacritty cask).
{{ if eq .chezmoi.os "darwin" }}
.config/alacritty
{{ else }}
.config/ghostty
{{ end }}

# Containers (Docker's /.dockerenv, podman's /run/.containerenv): no desktop, so no window manager,
# launcher or terminal config.
{{ if or (stat "/.dockerenv") (stat "/run/.containerenv") }}
.config/sway
.config/rofi
.config/alacritty
{{ end }}
