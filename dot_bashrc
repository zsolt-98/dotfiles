# .bashrc
# Managed by chezmoi. Machine-only tweaks go in ~/.bashrc.local (untracked).

# Source global definitions (Fedora; Debian/Mint load /etc/bash.bashrc on their own)
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment (shared with zsh: brew, PATH, pnpm, editor, FZF)
. "$HOME/.config/shell/env.sh"
command -v mise >/dev/null && eval "$(mise activate bash)"

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc

# Machine-local overrides (untracked)
if [ -f ~/.bashrc.local ]; then
    . ~/.bashrc.local
fi
