# Shared environment for zsh and bash (POSIX sh). Managed by chezmoi.
# Shell-specific setup (oh-my-zsh, mise activate) lives in .zshrc / .bashrc.

# --- Homebrew ---
if [ -x "{{ .brewprefix }}/bin/brew" ]; then
  eval "$("{{ .brewprefix }}/bin/brew" shellenv)"
fi

# --- PNPM ---
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in *":$PNPM_HOME:"*) ;; *) PATH="$PNPM_HOME:$PATH" ;; esac
case ":$PATH:" in *":$PNPM_HOME/bin:"*) ;; *) PATH="$PNPM_HOME/bin:$PATH" ;; esac

# --- User bins (claude lives here) ---
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac
export PATH

# --- Preferred editor (Claude Code Ctrl+G uses $VISUAL/$EDITOR) ---
export EDITOR='nvim'
export VISUAL='nvim'

# --- FZF (with hidden files support) ---
# FZF keybindings & completion loaded via zvm_after_init in .zshrc (zsh-vi-mode resets keys)
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'

# Claude Code: keep truecolor inside tmux (otherwise clamps to 256 colors)
export CLAUDE_CODE_TMUX_TRUECOLOR=1
