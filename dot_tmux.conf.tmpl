# Keep default prefix (Ctrl+b)
# M1 sends Ctrl+b

# Enable mouse/touch support (tap panes to select, scroll history)
set -g mouse on

# Status bar at top
set -g status-position top

# Monokai Pro Ristretto (values from .chezmoidata/palette.toml in the dotfiles repo)
set -g status-style "bg={{ .palette.sidebar_bg }},fg={{ .palette.foreground }}"
set -g status-left "#[bg={{ .palette.yellow }},fg={{ .palette.background }},bold] #S #[default] "
set -g status-right "#[fg={{ .palette.dimmed }}]%H:%M "
set -g window-status-format " #I:#W "
set -g window-status-current-format " #I:#W "
set -g window-status-style "fg={{ .palette.dimmed }}"
set -g window-status-current-style "bg={{ .palette.active_row_bg }},fg={{ .palette.yellow }},bold"
set -g pane-border-style "fg={{ .palette.selection }}"
set -g pane-active-border-style "fg={{ .palette.yellow }}"
set -g message-style "bg={{ .palette.selection }},fg={{ .palette.foreground }}"
set -g mode-style "bg={{ .palette.selection }},fg={{ .palette.foreground }}"

# Pass Ctrl+Shift and other modified keys through to nvim/herdr (Alacritty supports it)
set -s extended-keys on
set -as terminal-features 'xterm*:extkeys'
set -as terminal-features 'alacritty*:extkeys'

# Vim keys in copy mode
setw -g mode-keys vi

# Move between panes with vim keys (arrows still work by default)
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# Open new splits and windows in the current pane's directory (default keys)
bind '"' split-window -v -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"
bind c new-window -c "#{pane_current_path}"

# 1-based indexing AND auto-renumbering on tab close
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on

# Save/restore sessions across reboots (prefix+Ctrl-s save, prefix+Ctrl-r restore)
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'
set -g @resurrect-capture-pane-contents 'on'

# Relaunch Claude panes on restore with the conversation picker (pick the right one per pane)
set -g @resurrect-processes 'lazygit "~claude->claude --resume"'

# Keep this line last
run '~/.tmux/plugins/tpm/tpm'
