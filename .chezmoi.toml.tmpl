{{- /* Runs on `chezmoi init`. Answers are stored in ~/.config/chezmoi/chezmoi.toml. */ -}}
{{- /* Defaults answer the prompts in non-interactive runs (install.sh passes --promptDefaults). */ -}}

{{- $name := promptStringOnce . "name" "Git name" "Zsolt" -}}
{{- $email := promptStringOnce . "email" "Git email" "zsolt.nagy998@gmail.com" -}}
{{- $signingkey := promptStringOnce . "signingkey" "Git signing key (leave empty for none)" "" -}}

{{- /* macOS only: opt-in keyboard defaults (key repeat, free Ctrl+arrows and Ctrl+Space). */ -}}
{{- $macosDefaults := false -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $macosDefaults = promptBoolOnce . "macos_defaults" "Overwrite macOS keyboard defaults (fast key repeat, free Ctrl+arrows and Ctrl+Space)" true -}}
{{- end -}}

{{- /* Homebrew prefix differs per OS/arch; templates use it instead of hardcoded paths. */ -}}
{{- $brewprefix := "/home/linuxbrew/.linuxbrew" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $brewprefix = "/opt/homebrew" -}}
{{-   if eq .chezmoi.arch "amd64" -}}
{{-     $brewprefix = "/usr/local" -}}
{{-   end -}}
{{- end -}}

{{- /* Remember where this source lives: a devcontainer clones it to ~/dotfiles, not the default path. */ -}}
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    signingkey = {{ $signingkey | quote }}
    brewprefix = {{ $brewprefix | quote }}
    macos_defaults = {{ $macosDefaults }}

[git]
    autoCommit = true
    autoPush = false
